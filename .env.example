# Azure OpenAI configuration
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_API_KEY=replace-with-key
AZURE_OPENAI_API_VERSION=2025-04-01-preview
APPLICATION_GATEWAY_HOST=https://your-appgw-dns-or-ip

# Azure SignalR Service (serverless) configuration (for sideband listen channel)
AZURE_SIGNALR_CONNECTION_STRING=Endpoint=https://your-signalr.service.signalr.net;AccessKey=replace-with-key;Version=1.0;
AZURE_SIGNALR_HUB_NAME=sideband

# FastAPI settings
PORT=8080
CONTAINER_APP_REVISION=local
